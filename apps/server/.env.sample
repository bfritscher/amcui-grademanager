NODE_ENV=production
SERVER_PORT=9001
JWT_SECRET=
SENTRY_DSN=
ADMIN_USER=admin
FRONTEND_DOMAIN=
YPERSISTENCE=/data/db
# Only the actual reverse proxy IPs/CIDRs; omit for direct connections.
AMCUI_TRUST_PROXY=
AMCUI_API_RATE_LIMIT=600
AMCUI_AUTH_IP_RATE_LIMIT=30
AMCUI_AUTH_ACCOUNT_RATE_LIMIT=10
# Public frontend base URL, used in confirmation, activation and admin email links.
AMCUI_WEB_URL=https://amcui.example.org
AMCUI_MAIL_FROM=AMCUI <amcui@example.org>
# Comma-separated recipients notified after an account's email is verified.
AMCUI_ADMIN_EMAILS=admin@example.org
AMCUI_SMTP_HOST=
AMCUI_SMTP_PORT=587
AMCUI_SMTP_SECURE=false
# Disable only for local SMTP capture servers such as Mailpit.
AMCUI_SMTP_REQUIRE_TLS=true
AMCUI_SMTP_USER=
AMCUI_SMTP_PASSWORD=
