  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc --version && tsc --build --verbose",
    "tsc": "./node_modules/bin/tsc",
    "coverage": "npm run build && c8 --clean --reporter text --reporter html --all node ./dist/server.js",
    "dev": "concurrently --kill-others --names \"BUILD,RUN\" -c \"bgBlue.bold,bgMagenta.bold\" \"tsc -w\" \"nodemon --legacy-watch --watch dist/ --inspect=0.0.0.0:5858 --nolazy ./dist/server.js\"",
    "start": "node --import ./dist/sentry.js ./dist/server.js",
    "test": "jest",
    "watch": "tsc -w"
  },
